# Kopier til .env og fyll inn. .env committes aldri.
# Merk: en ANTHROPIC_API_KEY som allerede er satt i skallet, går foran verdien i .env.
ANTHROPIC_API_KEY=
# Valgfritt: modell og effort for tolkningen (standard: claude-opus-5-5, high) og veilederen (medium)
INTERPRET_MODEL=
INTERPRET_EFFORT=
# Self-consistency: never | low_confidence (standard) | always. low_confidence kan tredoble kostnaden for usikre oppgaver.
INTERPRET_CONSISTENCY=
AGENT_MODEL=
AGENT_EFFORT=
# Valgfritt: tilgangskoder for testbrukere, skilt med komma (slipper forbi innlogging og kvote).
ACCESS_CODES=
# Innlogging og kvote med Supabase (se docs/auth.md). Uten disse er innloggingen av, og /mcp er åpen.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Hemmelig (bare på serveren): teller kvoten. Sett aldri denne i en variabel som starter med VITE_.
SUPABASE_SECRET_KEY=
# Valgfritt: gratis kvote per uke. Webappen: tolkninger og spørsmål til veilederen. Claude (MCP): oppgaver.
QUOTA_INTERPRET_PER_WEEK=
QUOTA_AGENT_PER_WEEK=
QUOTA_TASKS_PER_WEEK=
VITE_QUOTA_TASKS_PER_WEEK=
# Valgfritt: fast offentlig adresse (lenker og OAuth-metadata) og kontaktadresse på personvernsiden
PUBLIC_URL=
VITE_CONTACT_EMAIL=
