# Kopier til .env og fyll inn. .env committes aldri.
# Merk: en ANTHROPIC_API_KEY som allerede er satt i skallet, går foran verdien i .env.
ANTHROPIC_API_KEY=
# Valgfritt: overstyr modell og effort for tolkningen (standard: claude-opus-5-5, high)
INTERPRET_MODEL=
INTERPRET_EFFORT=
# Self-consistency: never | low_confidence (standard) | always. low_confidence kan tredoble kostnaden for usikre oppgaver.
INTERPRET_CONSISTENCY=
# Valgfritt: modell og effort for veilederen (standard: claude-opus-5-5, medium)
AGENT_MODEL=
AGENT_EFFORT=
# Valgfritt: tilgangskoder, skilt med komma (én per testbruker). Tom = API-et er åpent (lokal utvikling).
ACCESS_CODES=
# Innlogging og ukekvote med Supabase (se docs/auth.md). Uten disse er innloggingen av, som før.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Hemmelig (bare på serveren): trekker kvoten. Sett aldri denne i en variabel som starter med VITE_.
SUPABASE_SECRET_KEY=
# Valgfritt: gratis kvote per uke (standard 10 tolkninger og 60 spørsmål til veilederen)
QUOTA_INTERPRET_PER_WEEK=
QUOTA_AGENT_PER_WEEK=
# Valgfritt: kontaktadresse på personvernsiden (for sletting av bruker)
VITE_CONTACT_EMAIL=
