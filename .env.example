# Kopier til .env og fyll inn. .env committes aldri.
# Uten Supabase-variablene er innloggingen av, og MCP-serveren på /mcp er åpen (lokal utvikling).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Hemmelig (bare på serveren): teller kvoten. Sett aldri denne i en variabel som starter med VITE_.
SUPABASE_SECRET_KEY=
# Valgfritt: gratis oppgaver per uke i MCP-serveren (standard 5). Samme tall i VITE_-utgaven vises på /konto.
QUOTA_TASKS_PER_WEEK=
VITE_QUOTA_TASKS_PER_WEEK=
# Valgfritt: fast offentlig adresse (ellers brukes adressen forespørselen kom til)
PUBLIC_URL=
# Valgfritt: kontaktadresse på personvernsiden (for sletting av bruker)
VITE_CONTACT_EMAIL=
# Bare for målingen av tolkningen (pnpm eval:interpret, koster penger). Brukes ikke av appen.
ANTHROPIC_API_KEY=
